# 單一資料源：同一份 env 檔由兩端各自原生讀取。env 檔一律放在 .env/ 子目錄。
#   - 網頁：由 `aqutter dev` / `aqutter seed` 依框架轉接器帶入（Nuxt 為 --dotenv，其餘為注入行程環境）
#   - Flutter：flutter (run|build) --dart-define-from-file=.env/.env.<profile> → String.fromEnvironment('KEY')
# 複製本檔為 .env/.env.dev（可進 git）/ .env/.env.prod（git 忽略，可放機密）後填值。
#
# 鍵的前綴即歸屬：AQUTTER_* 只有殼在讀，其餘鍵由網頁專案自己的規則決定。

# --- 網頁自己的設定（依你的框架填，例如 Nuxt 的 NUXT_PUBLIC_*、Vite 的 VITE_*）---

# --- Aqutter 殼（Dart 端以原 key 名 String.fromEnvironment 讀取；一律 AQUTTER_ 前綴）---
# 熱更新遠端來源；留空＝不啟用線上更新（僅用種子 / 現有版本）
AQUTTER_UPDATE_BASE_URL=

# 版本查詢的端點路徑，相對於 AQUTTER_UPDATE_BASE_URL。可為靜態檔或 API 路由
# （如 v1/app/check-update）。留空＝version.json
AQUTTER_UPDATE_VERSION_PATH=version.json

# 版本查詢的 HTTP method：GET | POST。留空＝GET。
#   GET ：不帶 body，契約為 GET {BASE}/{VERSION_PATH}
#   POST：body 為 { "currentVersion": <字串或 null>, "platform": "android|ios|macos|windows|linux" }
#         currentVersion 為 null 表示首開或無版本標記，伺服器應視為最舊
# 兩者的回應格式相同：{ "version": "...", "url": "...", "sha256": "..." }
# 值打錯（如 Post）會在啟動時直接報錯，不會靜默退回 GET
AQUTTER_UPDATE_METHOD=GET

# API KEY；留空＝不帶任何鑑權 header。機密請放 .env.prod（git 忽略）
AQUTTER_UPDATE_API_KEY=

# 承載 AQUTTER_UPDATE_API_KEY 的 header 名。留空＝X-Api-Key
# 要用 Bearer 就設 Authorization，並把 AQUTTER_UPDATE_API_KEY 填成 "Bearer <token>"
AQUTTER_UPDATE_API_KEY_HEADER=X-Api-Key

# 下載 bundle.zip 時是否也帶鑑權 header：true | false。留空＝true
# zip 的網址由版本回應給定，若指向第三方 CDN 的 pre-signed URL 請設 false，
# 否則等於把 KEY 送給該網域
AQUTTER_UPDATE_BUNDLE_AUTH=true

# 是否要求版本查詢必須成功才能進網頁：true | false。留空＝false
# true 時即使本機已有種子包或先前更新過的版本也不放行——查詢失敗（離線、伺服器不通、
# 回應格式錯）進「無法確認版本」阻擋頁並可重試。適合離線就不該能用、或必須確保版本
# 一致的 App。開啟時 AQUTTER_UPDATE_BASE_URL 不得留空，否則啟動即報錯（矛盾配置）
AQUTTER_UPDATE_REQUIRED=false

# 網頁包簽章的公鑰（Ed25519，標準 Base64 的 32 位元組原始公鑰，可用逗號分隔多把）。留空＝不驗簽章
# 設了就一律要求 version.json 帶 sha256 與 signature，缺少或驗證不過都拒絕更新並保留現行網頁包。
# 這是編譯期設定，網頁無法更改。公鑰不是機密；私鑰絕對不要放進 env 檔或專案。
# 產生金鑰與簽章：aqutter bundle keygen、aqutter bundle sign
# 多把公鑰用於金鑰輪替：新舊並存，任一把驗證通過即可。
AQUTTER_UPDATE_PUBLIC_KEYS=

# 網頁就緒的等待上限（秒）。留空＝300
# 自 WebView 的 onLoadStop 起算，逾時即判定網頁包壞掉並回滾到前一版。
# 寧可高不可低：設低的代價不是「等太久」，而是把慢的裝置誤判為壞掉、平白回滾。
AQUTTER_WEB_READY_TIMEOUT_SECONDS=300

# WebView 是否開放遠端檢查（true / false）。留空＝false
# Android → chrome://inspect（WebView.setWebContentsDebuggingEnabled）；iOS 16.4+ / macOS 13.3+ →
# Safari Web Inspector（WKWebView.isInspectable）；Windows → WebView2 DevTools。
# 編譯期注入，每個 build 固定：UAT 包可開、prod 包明確關。Android debug build 本就可檢查，
# 本開關的意義在 release build 與 Apple / Windows 平台。非 true/false 啟動即報錯。
AQUTTER_WEBVIEW_DEBUG=false

# 更新伺服器的連線逾時（秒）。留空＝30
# 刻意不跟著接收逾時一起放寬——連不上就是連不上，等再久也不會變成連得上。
AQUTTER_UPDATE_CONNECT_TIMEOUT_SECONDS=30

# 網頁包下載的接收逾時（秒）。留空＝600
# 砍掉的是「已經在下載中」的更新，代價與就緒誤判同級，故取寬鬆值。
AQUTTER_UPDATE_RECEIVE_TIMEOUT_SECONDS=600

# 註：AQUTTER_DEV_URL 由 `aqutter dev <target>` 依目標平台自動注入
#     （桌面 / iOS 模擬器＝localhost；Android＝adb reverse localhost；iOS 實機＝開發機區網 IP），
#     不需在此設定。手動 flutter run 時可自行加 --dart-define=AQUTTER_DEV_URL=...
