<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 本機通知排程在裝置重新開機後要重新排上（AqutterBootReceiver） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!--
          圖片剪貼簿用的 FileProvider。刻意用自己的子類別：App 自己可能已經宣告了
          androidx.core.content.FileProvider（例如自主更新 APK 用的），兩個同名元素在 manifest 合併時會互相衝突。
          檔案白名單只有 cache/aqutter_clipboard/。
        -->
        <provider
            android:name="com.github.aqutter.shell.clipboard.AqutterClipboardProvider"
            android:authorities="${applicationId}.aqutter.clipboard"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/aqutter_clipboard_paths" />
        </provider>

        <!-- 本機通知：排程時間到了顯示通知 -->
        <receiver
            android:name="com.github.aqutter.shell.notification.AqutterNotificationReceiver"
            android:exported="false" />

        <!-- 重新開機、App 更新後重新排程 -->
        <receiver
            android:name="com.github.aqutter.shell.notification.AqutterBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
